          "step": 0.1,
          "label": "%",
          "labelMultiplier": 100,
          "labelDecimals": 0
        }
      ]
    },
    {
      "id": "ufp_start_device_siren",
      "title": {
        "en": "Start siren",
        "nl": "Start sirene"
      },
      "titleFormatted": {
