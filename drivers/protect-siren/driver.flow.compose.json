            { "id": "10", "label": { "en": "10 seconds", "nl": "10 seconden" } },
            { "id": "20", "label": { "en": "20 seconds", "nl": "20 seconden" } },
            { "id": "30", "label": { "en": "30 seconds", "nl": "30 seconden" } }
          ]
        }
      ]
    },
    {
      "id": "ufp_stop_device_siren",
      "title": {
        "en": "Stop siren",
        "nl": "Stop sirene"
      }
    }
